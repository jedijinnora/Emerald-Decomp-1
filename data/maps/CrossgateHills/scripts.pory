mapscripts CrossgateHills_MapScripts {}

script CrossgateHills_EventScript_Sign {
    msgbox(format("Crossgate Hills\p“Between desert winds and rain-swept jungle.”"), MSGBOX_SIGN)
    end
}

script CrossgateHills_EventScript_UmbrellaLady {
    lock
    faceplayer
    msgbox(format("I'm the leader of the Parasol Lady Society."))
    call_if_unset(FLAG_RECEIVED_UTILITY_UMBRELLA, CrossgateHills_EventScript_CheckParasolLadies)
    msgbox(format("A parasol is simply the most divine personal accessory. That's what I think."))
    release
    end
}

script CrossgateHills_EventScript_CheckParasolLadies {
    goto_if_not_defeated(TRAINER_MADELINE, CrossgateHills_NoUmbrellaForYou)
    goto_if_not_defeated(TRAINER_RACHEL, CrossgateHills_NoUmbrellaForYou)
    goto_if_not_defeated(TRAINER_CLARISSA, CrossgateHills_NoUmbrellaForYou)
    goto_if_not_defeated(TRAINER_ANGELICA, CrossgateHills_NoUmbrellaForYou)
    goto_if_not_defeated(TRAINER_KAYLEY, CrossgateHills_NoUmbrellaForYou)
    goto_if_not_defeated(TRAINER_CLEO, CrossgateHills_NoUmbrellaForYou)
    goto_if_not_defeated(TRAINER_HALLIE, CrossgateHills_NoUmbrellaForYou)

    msgbox(format("Nice work defeating the other Parasol Ladies! Use this to shield your darlings from the weather."))
    giveitem(ITEM_UTILITY_UMBRELLA)
    setflag(FLAG_RECEIVED_UTILITY_UMBRELLA)
    return

    CrossgateHills_NoUmbrellaForYou:
    msgbox(format("If you defeat all the other Parasol Ladies in Hoenn, I'll grant you honorary membership!"))
    return
}

script CrossgateHills_EventScript_Kaiten {
    trainerbattle_single(TRAINER_KAITEN, CrossgateHills_Text_KaitenIntro, CrossgateHills_Text_KaitenDefeat)
	msgbox(CrossgateHills_Text_KaitenPostBattle, MSGBOX_AUTOCLOSE)
	call(CrossgateHills_EventScript_TryKaitenRematch)
	release
	end
}
script CrossgateHills_EventScript_TryKaitenRematch {
	lock
    call(Common_EventScript_ShouldDoRematch)
	goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_NopReturn)
	setvar(VAR_0x8003, TRAINER_KAITEN)
	setvar(VAR_0x8004, 1)
	call(Common_EventScript_CheckRecentRematchesSetBP)
	trainerbattle_no_intro(TRAINER_KAITEN, CrossgateHills_Text_KaitenDefeat)
	special(UpdateRecentTrainers)
	return
}
text CrossgateHills_Text_KaitenIntro {
	"I strike with the divine wind!"
}
text CrossgateHills_Text_KaitenDefeat {
	"How could you withstand our fury?"
}
text CrossgateHills_Text_KaitenPostBattle {
	"The breeze that blows over these hills \n"
	"keeps the nasty desert sand away."
}

