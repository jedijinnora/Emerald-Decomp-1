text CrossgateHills_Text_WalkerIntro {
	"Hey, hey! Stop and enjoy the breeze!"
}
text CrossgateHills_Text_WalkerDefeat {
	"Man, you brought the doldrums."
}
text CrossgateHills_Text_WalkerPostBattle {
	"The thermals rising off of the hot\n"
    "desert let birds soar high in the sky."
}

