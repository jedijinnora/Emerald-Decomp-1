script Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Question_5 {
	clearflag(FLAG_TEMP_15)
	msgbox(format("ANSWER ALL THREE QUESTIONS CORRECTLY TO PASS. YOU'LL BE GRADED AT THE END!"))

	// Q1: Bike routes (must be completed without dismounting)
	random(4)
	switch(var(VAR_RESULT)) {
		case 0:
			msgbox(format("Can I ride my Acro Bike from Lilycove to Fortree?"), MSGBOX_YESNO)
			// Yes: Lilycove -> 121 -> 122 -> 123 -> 118 -> Mauville -> 111 -> Desert Underpass -> Sandswept Oasis -> Crossgate Hills -> 119 -> Fortree
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 1:
			msgbox(format("Can I ride my Acro Bike from Fortree to Lilycove?"), MSGBOX_YESNO)
			// Yes: Fortree -> 119 -> Crossgate Hills -> Sandswept Oasis -> 111 -> Mauville -> 118 -> 123 -> 122 -> 121 -> Lilycove
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 2:
			msgbox(format("Can I ride my Mach Bike from Lilycove to Fortree?"), MSGBOX_YESNO)
			// Yes: Lilycove -> Sunrise Shore -> 123 -> 118 -> Mauville -> 111 -> Sandswept Oasis -> Crossgate Hills -> 119 -> Fortree
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 3:
			msgbox(format("Can I ride my Mach Bike from Fortree to Lilycove?"), MSGBOX_YESNO)
			// No: blocked by ledges on r123
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		default:
	}

	// Q2: Surf routes (must be completed without dismounting)
	random(6)
	switch(var(VAR_RESULT)) {
		case 0:
			msgbox(format("Can I Surf from Petalbug to Southern Island?"), MSGBOX_YESNO)
			// No: blocked by shallow water/beach on r109
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 1:
			msgbox(format("Can I Surf from Southern Island to Ever Grande?"), MSGBOX_YESNO)
			// Yes: Southern Island -> Summer Sea -> 133 -> 132 -> Pacifidlog -> 131 -> 130 -> 129 -> 128 -> Ever Grande
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 2:
			msgbox(format("Can I Surf from Sunrise Shore to Route 125?"), MSGBOX_YESNO)
			// Yes: Sunrise Shore -> 128 -> Mossdeep -> 125
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 3:
			msgbox(format("Can I use Surf and Dive from Route 125 to Sootopolis without entering Mossdeep?"), MSGBOX_YESNO)
			// Yes: 125 -> 124 -> 126 -> Sootopolis
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 4:
			msgbox(format("Would Mirage Island prevent me from Surfing across Route 130?"), MSGBOX_YESNO)
			// No
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 5:
			msgbox(format("Can I Surf from Slateport to Pacifidlog?"), MSGBOX_YESNO)
			// Yes, the currents go both ways
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		default:
	}

	// Q3: Land routes
	random(5)
	switch(var(VAR_RESULT)) {
		case 0:
			msgbox(format("I have no bike and no HMs! Can I walk from Petalburg to Mauville?"), MSGBOX_YESNO)
			// Yes, many routes
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 1:
			msgbox(format("I have no bike and no HMs! Can I walk from Meteor Village to Slateport?"), MSGBOX_YESNO)
			// Yes: 
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 2:
			msgbox(format("I hate bridges, caves, and sand! Can I walk from Verdanturf to Fallarbor?"), MSGBOX_YESNO)
			// No
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 3:
			msgbox(format("I hate tall grass! Can I walk from Mauville to Petalburg?"), MSGBOX_YESNO)
			// No
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 4:
			msgbox(format("I hate tall grass! Can I walk from Petalburg to Mauville?"), MSGBOX_YESNO)
			// Yes
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		default:
	}

	msgbox(format("CALCULATING RESPONSES..."))
	goto_if_set(FLAG_TEMP_15, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Incorrect)
	goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Correct)
	end
}

script Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Question_6 {	
