const LOCALID_DOCTOR = 8

mapscripts Route110_TrickHousePuzzle5_MapScripts {
	MAP_SCRIPT_ON_TRANSITION : Route110_TrickHousePuzzle5_OnTransition
}

script Route110_TrickHousePuzzle5_OnTransition {
	cleartrainerflag(TRAINER_IRVIN)
	cleartrainerflag(TRAINER_KELSEY)
	cleartrainerflag(TRAINER_TOBY)
	cleartrainerflag(TRAINER_ALICIA)
	cleartrainerflag(TRAINER_OLIVER)
	end
}

script Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll {
	lock
	faceplayer
	msgbox(format("CLICKETY-CLACK…\nDOCTOR MECHADOLL AM I!"))
	msgbox(format("IF YOU ANSWER QUIZZES CORRECTLY, HEAL YOUR POKéMON I WILL!"))
	msgbox(format("FAILURE MAY HAVE CONSEQUENCES!"))
	msgbox(format("WOULD YOU LIKE TO PLAY?"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Quiz)
	DoctorMechadollEnd:
	msgbox(Route110_TrickHousePuzzle5_Text_DisappointmentError)
	release
	end
}

script Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Quiz {
	if(!flag(FLAG_TEMP_11)) {
		dynmultipush("Battle mechanics.", 1)
	}
	if(!flag(FLAG_TEMP_12)) {
		dynmultipush("The Hoenn region.", 2)
	}
	if(!flag(FLAG_TEMP_13)) {
		dynmultipush("Memery and mischief.", 3)
	}
	if(!flag(FLAG_TEMP_14)) {
		dynmultipush("VGC lore.", 4)
	}
	msgbox(format("WHICH CATEGORY IS YOUR FAVORITE?"))
	dynmultistack(0,0,FALSE,6,FALSE,1,DYN_MULTICHOICE_CB_NONE)
	switch(var(VAR_RESULT)) {
		case 1:
			setflag(FLAG_TEMP_11)
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Q_Battle)
		case 2:
			setflag(FLAG_TEMP_12)
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Q_Hoenn)
		case 3:
			setflag(FLAG_TEMP_13)
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Q_Meme)
		case 4:
			setflag(FLAG_TEMP_14)
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Q_VGC)
		default:
	}
	goto(DoctorMechadollEnd)
	end
}

