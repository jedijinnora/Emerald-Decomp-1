// Rapid Spin does not clear hazards if the user dies to contact damage
// Court Change is not affected by protect
// Thus P1's side has both Stealth Rock and Spikes present
script Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Question_1 {
	dynmultipush("Read prompt again.", 1)
	dynmultipush("P1: None. P2: None.", 2)
	dynmultipush("P1: Spikes. P2: None.", 3)
	dynmultipush("P1: Stealth Rock. P2: None.", 4)
	dynmultipush("P1: None. P2: Stealth Rock.", 5)
	dynmultipush("P1: None. P2: Spikes.", 6)
	dynmultipush("P1: Spikes. P2: Stealth Rock.", 7)
	dynmultipush("P1: Stealth Rock. P2: Spikes.", 8)
	dynmultipush("P1: Spikes and Stealth Rock. P2: None.", 9)
	dynmultipush("P1: None. P2: Spikes and Stealth Rock.", 10)
	msgbox(format("A battle is in progress and proceeds as follows:"))
	msgbox(format("Turn 1: P1's Gligar uses Stealth Rock. P2's Cloyster uses Rapid Spin, and faints to Rocky Helmet."))
	msgbox(format("Turn 2: P2 sends out Scizor. P1's Gligar uses Spikes. P2's Scizor uses U-Turn."))
	msgbox(format("Turn 3: P2 sends out Cinderace. P1's Gligar uses Protect. P2's Cinderace uses Court Change."))
	msgbox(format("Question: after Turn 3, which hazards affect each player's side of the field?"))
	dynmultistack(0,0,TRUE,6,FALSE,1,DYN_MULTICHOICE_CB_NONE)
	switch(var(VAR_RESULT)) {
		case 1:
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Question_1)
		case 9:
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Correct)
		default:
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Incorrect)
	}
	end
}

// Glimmora must have Toxic Debris, meaning two layers of Toxic Spikes
// Thus Breloom is badly poisoned, and takes damage after Lickitung knocks off its Ability Shield and Neutralizing Gas Weezing is on the field
// The toxic counter still ticks while Poison Heal is active, so the correct answer is 3/16ths damage from poison
script Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Question_2 {
	dynmultipush("Read prompt again.", 1)
	dynmultipush("Breloom is healed by the poison.", 2)
	dynmultipush("Loses 1/16th of its health from poison.", 3)
	dynmultipush("Loses 1/8th of its health from poison.", 4)
	dynmultipush("Loses 3/16ths of its health from poison.", 5)
	dynmultipush("Loses 5/16ths of its health from poison.", 6)
	msgbox(format("A battle is in progress and proceeds as follows:"))
	msgbox(format("Turn 1: P1's Glimmora uses Toxic. P2's Empoleon is not poisoned, and uses Waterfall, knocking out Glimmora."))
	msgbox(format("Turn 2: P1 sends out Roselia. Roselia uses Toxic Spikes. P2's Empoleon uses Ice Beam, knocking out Roselia and fainting to Life Orb recoil."))
	msgbox(format("Turn 3: P1 sends out Arcanine. P2 sends out Breloom, who is affected by Toxic Spikes. Arcanine's Intimidate does not affect Breloom. Breloom knocks out Arcanine with Mach Punch."))
	msgbox(format("Turn 4: P1 sends out Lickitung. P2's Breloom uses Mach Punch. P1's Lickitung uses Knock Off."))
	msgbox(format("Turn 5: P2's Breloom uses Mach Punch, knocking out Lickitung. P1 sends out Weezing with Neutralizing Gas."))
	msgbox(format("It is the end of Turn 5. Breloom's ability is Poison Heal."))
	msgbox(format("Question: How will Breloom be affected by poison at the end of Turn 5?"))
	dynmultistack(0,0,TRUE,6,FALSE,1,DYN_MULTICHOICE_CB_NONE)
	switch(var(VAR_RESULT)) {
		case 1:
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Question_2)
		case 5:
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Correct)
		default:
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Incorrect)
	}
	end
}

