	switch(var(VAR_RESULT)) {
		case 0:
			dynmultipush("Verdant Forest.", 7)
			dynmultipush("Abandoned Ship.", 8)
		case 1:
			dynmultipush("Mt. Pyre.", 4)
			dynmultipush("Cave of Origin.", 15)
			dynmultipush("Verdant Forest.", 19)
		default:
			dynmultipush("Victory Road.", 9)
			dynmultipush("Scorched Slab.", 16)
	}
	random(3)
	switch(var(VAR_RESULT)) {
		case 0:
			dynmultipush("Route 106.", 10)
			dynmultipush("Summer Sea.", 17)
		case 1:
			dynmultipush("Route 114.", 11)
		default:
			dynmultipush("Route 122.", 18)
	}
	random(3)
	switch(var(VAR_RESULT)) {
		case 0:
			dynmultipush("Route 116.", 24)
			dynmultipush("Route 113.", 1)
		case 1:
			dynmultipush("Route 113.", 24)
			dynmultipush("Mossdeep City.", 25)
			dynmultipush("Fortree City.", 1)
		default:
			dynmultipush("Pacifidlog Town.", 24)
			dynmultipush("Fortree City.", 25)
	}

	//correct answer
	random(4)
	switch(var(VAR_RESULT)) {
		case 0:
			dynmultipush("Crossgate Hills.", 12)
		case 1:
			dynmultipush("Sakurai Overlook.", 12)
		case 2:
			dynmultipush("Safari Zone.", 12)
		default:
			dynmultipush("Sootopolis Gardens.", 12)
	}

	msgbox(format("I want any Ghost-type Pokémon! Where should I not look?"))
	dynmultistack(0,0,TRUE,6,TRUE,1,DYN_MULTICHOICE_CB_NONE)
	switch(var(VAR_RESULT)) {
		case 12:
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Correct)
		default:
			goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Incorrect)
	}
	end
}

