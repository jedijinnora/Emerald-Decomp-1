script Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Question_12 {
	clearflag(FLAG_TEMP_15)
	msgbox(format("ANSWER ALL THREE QUESTIONS CORRECTLY TO PASS. YOU'LL BE GRADED AT THE END!"))

	// Q1
	random(4)
	switch(var(VAR_RESULT)) {
		case 0:
			msgbox(format("Metagross has won more Worlds than Salamence?"), MSGBOX_YESNO)
			// No: 2009 and 2012 vs. 2009, 2018, and 2019
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 1:
			msgbox(format("Salamence has won more Worlds than Metagross?"), MSGBOX_YESNO)
			// Yes: 2009, 2018, and 2019 vs. 2009 and 2012
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 2:
			msgbox(format("The only starter to win a World Championship is Incineroar?"), MSGBOX_YESNO)
			// No: Empoleon, 2009 and Rillaboom, 2022
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 3:
			msgbox(format("Both Urshifu forms have won a VGC World Championship?"), MSGBOX_YESNO)
			// No: both were rapid strike (water)
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		default:
	}

	// Q2
	random(4)
	switch(var(VAR_RESULT)) {
		case 0:
			msgbox(format("Is Tyranitar is the only Generation 2 Pokémon to win a World Championship?"), MSGBOX_YESNO)
			// No: Hitmontop, 2016
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 1:
			msgbox(format("Thundurus has the most Worlds victories of all Generation 5 Pokémon?"), MSGBOX_YESNO)
			// No: Amoonguss also has 3
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 2:
			msgbox(format("Only the USA and Japan have more than one Worlds winner?"), MSGBOX_YESNO)
			// No: Italy has Arash Ommati (2013) and Luca Ceribelli (2024)
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 3:
			msgbox(format("There is no single type present on all winning Worlds Teams?"), MSGBOX_YESNO)
			// Yes
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		default:
	}

	// Q3
	random(5)
	switch(var(VAR_RESULT)) {
		case 0:
			msgbox(format("Zacian-crowned has the highest BST of all Worlds winners?"), MSGBOX_YESNO)
			// No: Primals and Mega-Ray
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 1:
			msgbox(format("Did the infamous CHALK team actually win Worlds?"), MSGBOX_YESNO)
			// Yes, with Thundurus as the 6th
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 2:
			msgbox(format("Paradox Pokémon have more wins than their standard counterparts?"), MSGBOX_YESNO)
			// Paradox: Iron Hands x2, Flutter Mane x2, Miraidon, Koraidon, Brute Bonnet = 7
			// Standard: Salamence x3, Amoonguss x3, Hydreigon x2, Hariyama, Terrakion, (Gardevoir) = 10 or 11
			// No
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 3:
			msgbox(format("Grass, Fire, and Water starters have all won Worlds?"), MSGBOX_YESNO)
			// Yes: Rillaboom, Incineroar, and Empoleon
			call_if_eq(VAR_RESULT, NO, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		case 4:
			msgbox(format("Every type of Pokémon has been present on a winning Worlds team?"), MSGBOX_YESNO)
			// No: Bug type
			call_if_eq(VAR_RESULT, YES, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong)
		default:
	}

	msgbox(format("CALCULATING RESPONSES..."))
	goto_if_set(FLAG_TEMP_15, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Incorrect)
	goto(Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Correct)
	end
}

script Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Correct {
	waitse
	playse(SE_SUCCESS)
	msgbox(format("CONGRATULATIONS. CORRECT YOU ARE."))
	call(Common_EventScript_OutOfCenterPartyHeal)
	addvar(VAR_TEMP_6, 1)
	goto_if_eq(VAR_TEMP_6, 3, Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Vanish)
	release
	end
}

script Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Incorrect {
	waitse
	playse(SE_FAILURE)
	msgbox(Route110_TrickHousePuzzle5_Text_DisappointmentError)
	applymovement(LOCALID_DOCTOR, Route110_TrickHousePuzzle5_Movement_MechadollShake)
	waitmovement(LOCALID_DOCTOR)
	Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Vanish:
	msgbox(Route110_TrickHousePuzzle5_Text_Wahahahaha)
	applymovement(LOCALID_DOCTOR, KecleonVanish)
	waitmovement(LOCALID_DOCTOR)
	removeobject(LOCALID_DOCTOR)
	release
	end
}

script Route110_TrickHousePuzzle5_EventScript_DoctorMechadoll_Wrong {
	setflag(FLAG_TEMP_15)
	return
}

