mapscripts MauvilleCity_House3_MapScripts {}

script MauvilleCity_House3_EventScript_Man {
	lock
	faceplayer
	msgbox(format("I am one awesome dude!"))
	goto_if_unset(FLAG_RECEIVED_BLACK_GLASSES, MauvilleCity_House3_EventScript_TryGiveBlackGlasses)
	msgbox(format("The whole wide world is playing one big game, and there's only one rule."))
	msgbox(format("Wanna hear it?"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, MauvilleCity_House3_EventScript_NoCoolPokemon)
	msgbox(format("If you think about the game…\pYou lose the game!"))
	release
	end
}

script MauvilleCity_House3_EventScript_TryGiveBlackGlasses {
	msgbox(format("Show me a Cool Pokémon and I'll share some awesomeness with you!"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, MauvilleCity_House3_EventScript_NoCoolPokemon)
	special(ChoosePartyMon)
	waitstate
	copyvar(VAR_RESULT, VAR_0x8004)
	goto_if_eq(VAR_RESULT, PARTY_NOTHING_CHOSEN, MauvilleCity_House3_EventScript_NoCoolPokemon)
	setvar(VAR_0x8005, CONTEST_CATEGORY_COOL)
	specialvar(VAR_TEMP_1, GetPartyMonContestRibbon)
	goto_if_ge(VAR_TEMP_1, 1, MauvilleCity_House3_EventScript_GiveBlackGlasses)
	setvar(VAR_0x8005, CONTEST_CATEGORY_COOL)
	specialvar(VAR_TEMP_2, GetPartyMonContestStat)
	goto_if_ge(VAR_TEMP_2, 100, MauvilleCity_House3_EventScript_GiveBlackGlasses)
	goto(MauvilleCity_House3_EventScript_NoCoolPokemon)
	end
}

script MauvilleCity_House3_EventScript_GiveBlackGlasses {
	msgbox(format("Woah! You need to accentuate that aura with these shades!"))
	giveitem(ITEM_BLACK_GLASSES)
	goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull)
	setflag(FLAG_RECEIVED_BLACK_GLASSES)
	release
	end
}

script MauvilleCity_House3_EventScript_NoCoolPokemon {
	msgbox(format("Mediocrity suits you."))
	release
	end
}

script MauvilleCity_House3_EventScript_PachirisuTrader {
    lock
	faceplayer
	goto_if_set(FLAG_MAUVILLE_PACHIRISU_TRADE_COMPLETED, PachirisuTradeCompleted)
	setvar(VAR_0x8008, INGAME_TRADE_PACHIRISU)
	copyvar(VAR_0x8004, VAR_0x8008)
	specialvar(VAR_RESULT, GetInGameTradeSpeciesInfo)
	copyvar(VAR_0x8009, VAR_RESULT)
	msgbox(format("My cousin sent me this electric squirrel Pokémon."))
    msgbox(format("He claims it can be really strong and awesome…"))
	msgbox(format("But I don't see what makes it special. Maybe you will?"))
    msgbox(format("I'd like to trade Pachirisu for your Gible."), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, DeclinePachirisuTrade)
	msgbox(format("Nice! Who needs a defensive Follow Me user anyways?"))
	waitmessage
	special(ChoosePartyMon)
	waitstate
	copyvar(VAR_0x800A, VAR_0x8004)
	goto_if_eq(VAR_0x8004, PARTY_NOTHING_CHOSEN, DeclinePachirisuTrade)
	copyvar(VAR_0x8005, VAR_0x800A)
	specialvar(VAR_RESULT, GetTradeSpecies)
	copyvar(VAR_0x800B, VAR_RESULT)
	goto_if_ne(VAR_RESULT, VAR_0x8009, SelectedNotGible)
	copyvar(VAR_0x8004, VAR_0x8008)
	copyvar(VAR_0x8005, VAR_0x800A)
	special(CreateInGameTradePokemon)
	special(DoInGameTradeScene)
	waitstate
	msgbox(format("Gible's gonna get me to the World Championships, you'll see."))
	setflag(FLAG_MAUVILLE_PACHIRISU_TRADE_COMPLETED)
	release
	end

	DeclinePachirisuTrade:
	msgbox(format("Fair enough. Don't know why anyone would want this off-brand Pikachu."))
	release
	end

	SelectedNotGible:
	bufferspeciesname(STR_VAR_1, VAR_0x800B)
	msgbox(format("I may not be the best Pokémon expert, but even I can tell that's not a Gible!"))
	release
	end

	PachirisuTradeCompleted:
	msgbox(format("Have you figured out why my cousin thinks Pachirisu is so strong?"))
	release
	end
}
