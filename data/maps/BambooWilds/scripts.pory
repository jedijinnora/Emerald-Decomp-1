mapscripts BambooWilds_MapScripts {
    MAP_SCRIPT_ON_TRANSITION : BambooWilds_OnTransition
}

script BambooWilds_OnTransition {
    call(Common_EventScript_DisableBPReward)
    end
}

script BambooWilds_EventScript_Humfrey {
    trainerbattle_single(TRAINER_HUMFREY, BambooWilds_Text_HumfreyIntro, BambooWilds_Text_HumfreyDefeat)
	msgbox(BambooWilds_Text_HumfreyPostBattle, MSGBOX_AUTOCLOSE)
	call(BambooWilds_EventScript_TryHumfreyRematch)
	release
	end
}
script BambooWilds_EventScript_TryHumfreyRematch {
	lock
    call(Common_EventScript_ShouldDoRematch)
	goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_NopReturn)
	setvar(VAR_0x8003, TRAINER_HUMFREY)
	setvar(VAR_0x8004, 1)
	call(Common_EventScript_CheckRecentRematchesSetBP)
	trainerbattle_no_intro(TRAINER_HUMFREY, BambooWilds_Text_HumfreyDefeat)
	special(UpdateRecentTrainers)
	return
}
text BambooWilds_Text_HumfreyIntro {
	"Buggy buggy bugs!"
}
text BambooWilds_Text_HumfreyDefeat {
	"Nooo! Bugs buggy!"
}
text BambooWilds_Text_HumfreyPostBattle {
	"My favorite cartoon character is Bugs\n"
	"Bunnelby."
}

