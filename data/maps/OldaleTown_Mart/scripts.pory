mapscripts OldaleTown_Mart_MapScripts {}

script OldaleTown_Mart_EventScript_Clerk {
    lock
	faceplayer
    msgbox(gText_HowMayIServeYou)
	waitmessage
	pokemart(0)
	msgbox(gText_PleaseComeAgain)
	release
	end
}

script OldaleTown_Mart_EventScript_Girl {
	lock
	faceplayer
	msgbox(format("Sigh…"))
	goto_if_unset(FLAG_RECEIVED_NEVER_MELT_ICE, OldaleTown_Mart_EventScript_TryGiveNeverMeltIce)
	msgbox(format("Oldale just doesn't have the glamor of a big city."))
	msgbox(format("Maybe in my next life I can grow up somewhere glitzy."))
	msgbox(format("Or I can just keep watching big city TV shows…"))
	release
	end
}

script OldaleTown_Mart_EventScript_TryGiveNeverMeltIce {
	msgbox(format("I wish Oldale had a bit more going on."))
	msgbox(format("Please show me a Beautiful Pokémon to relieve my boredom?"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, OldaleTown_Mart_EventScript_NoBeautifulPokemon)
	special(ChoosePartyMon)
	waitstate
	copyvar(VAR_RESULT, VAR_0x8004)
	goto_if_eq(VAR_RESULT, PARTY_NOTHING_CHOSEN, OldaleTown_Mart_EventScript_NoBeautifulPokemon)
	setvar(VAR_0x8005, CONTEST_CATEGORY_BEAUTY)
	specialvar(VAR_TEMP_1, GetPartyMonContestRibbon)
	goto_if_ge(VAR_TEMP_1, 1, OldaleTown_Mart_EventScript_GiveNeverMeltIce)
	setvar(VAR_0x8005, CONTEST_CATEGORY_BEAUTY)
	specialvar(VAR_TEMP_2, GetPartyMonContestStat)
	goto_if_ge(VAR_TEMP_2, 100, OldaleTown_Mart_EventScript_GiveNeverMeltIce)
	goto(OldaleTown_Mart_EventScript_NoBeautifulPokemon)
	end
}

script OldaleTown_Mart_EventScript_GiveNeverMeltIce {
	msgbox(format("Oh, yes. That's quite the sight."))
	msgbox(format("Here, I'd like you to have this."))
	giveitem(ITEM_NEVER_MELT_ICE)
	goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull)
	setflag(FLAG_RECEIVED_NEVER_MELT_ICE)
	msgbox(format("I want to be as beautiful as Kanto's Elite Four Lorelei someday…"))
	release
	end
}

script OldaleTown_Mart_EventScript_NoBeautifulPokemon {
	msgbox(format("Beauty is in the eye of the beholder, and I'm seeing none."))
	release
	end
}
