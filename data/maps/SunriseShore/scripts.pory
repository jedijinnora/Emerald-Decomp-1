text SunriseShore_Text_WarnerIntro {
	"You've come to meet your demise at the\n"
    "hands of Warner Huntington the third!"
}
text SunriseShore_Text_WarnerDefeat {
	"My family has lots of money! Whatever!"
}
text SunriseShore_Text_WarnerPostBattle {
	"You're even more annoying than my ex's\n"
	"dumb Furfrou!"
}

