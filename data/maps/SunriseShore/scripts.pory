mapscripts SunriseShore_MapScripts {}

script SunriseShore_EventScript_LookoutSign {
    msgbox(format("Lilycove Overlook"), MSGBOX_SIGN)
    end
}

script SunriseShore_EventScript_EastSign {
    msgbox(format("Sunrise Shore\n{UP_ARROW} Lilycove City\l{RIGHT_ARROW} Route 124"), MSGBOX_SIGN)
    end
}

script SunriseShore_EventScript_WestSign {
    msgbox(format("Sunrise Shore\n{LEFT_ARROW} Route 123 and Mt. Pyre"), MSGBOX_SIGN)
    end
}

script SunriseShore_EventScript_Cyclist {
    msgbox(format("No, I don't want to battle. I'm busy! Out of the way please."), MSGBOX_NPC)
    end
}

script SunriseShore_EventScript_SunshineLady {
    msgbox(format("I love how sunny it is here! I found a Sun Stone just the other day."), MSGBOX_NPC)
    end
}

script SunriseShore_EventScript_Poochyena {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_POOCHYENA, CRY_MODE_ENCOUNTER)
    msgbox(format("Poochyena snarls at you. She seems frustrated with humans."))
    release
    end
}

script SunriseShore_EventScript_MagmaGuy {
    lock
    faceplayer
    msgbox(format("Look, if we dam the mouth of the bay we can reclaim tons of land for development. There's still loads of sea we haven't touched."))
    msgbox(format("Who cares about a bit of pollution or some fish? We have a future to build!"))
    release
    end
}

script SunriseShore_EventScript_AquaGuy {
    lock
    faceplayer
    msgbox(format("We've done enough damage to the ocean around Lilycove already! We need to be protecting the ecosystem, not trashing it further."))
    msgbox(format("Environmentalism may not turn a profit in the short term, but in the long run we're all better off for it!"))
    release
    end
}

script SunriseShore_EventScript_Caile {
	trainerbattle_single(TRAINER_CAILE, SunriseShore_Text_CaileIntro, SunriseShore_Text_CaileDefeat)
	msgbox(SunriseShore_Text_CailePostBattle, MSGBOX_AUTOCLOSE)
	call(SunriseShore_EventScript_TryCaileRematch)
	release
	end
}
script SunriseShore_EventScript_TryCaileRematch {
	lock
    call(Common_EventScript_ShouldDoRematch)
	goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_NopReturn)
	setvar(VAR_0x8003, TRAINER_CAILE)
	setvar(VAR_0x8004, 1)
	call(Common_EventScript_CheckRecentRematchesSetBP)
	trainerbattle_no_intro(TRAINER_CAILE, SunriseShore_Text_CaileDefeat)
	special(UpdateRecentTrainers)
	return
}
text SunriseShore_Text_CaileIntro {
	"So much to do, so many Trainers to\n"
	"battle…"
}
text SunriseShore_Text_CaileDefeat {
	"So many steps to walk back to Lilycove…"
}
text SunriseShore_Text_CailePostBattle {
	"I fill my days with walks all around the\n"
	"region. How about you?"
}

