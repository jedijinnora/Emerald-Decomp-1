text SunriseShore_Text_CallahanIntro {
	"My lessons are on fire! All of my\n"
    "student reviews admit it!"
}
text SunriseShore_Text_CallahanDefeat {
	"Someone brought a wet blanket to\n"
    "class…"
}
text SunriseShore_Text_CallahanPostBattle {
	"Teaching kids to start fires is much\n"
	"more fun than teaching them how to\l"
    "extinguish them."
}

