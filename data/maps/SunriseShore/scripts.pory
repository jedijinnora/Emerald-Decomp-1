text SunriseShore_Text_TrevorIntro {
	"It's illegal to say “I want to kill the\n"
    "Champion of the Hoenn region”.\p"
    "Super, super illegal!"
}
text SunriseShore_Text_TrevorDefeat {
    "We have a group that meets Fridays.\n"
	"Want an invite?"
}
text SunriseShore_Text_TrevorPostBattle {
	"Sic semper tyrannis!"
}