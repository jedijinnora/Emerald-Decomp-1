script PathlessForest_EventScript_Farfetchd {
    lock
    faceplayer
    playmoncry(SPECIES_FARFETCHD, CRY_MODE_ENCOUNTER)
    msgbox(format("Farfetch'd is completely turned around…"))
    release
    end
}

script PathlessForest_EventScript_Psyduck {
    lock
    faceplayer
    playmoncry(SPECIES_PSYDUCK, CRY_MODE_ENCOUNTER)
    msgbox(format("Is this Psyduck more confused than usual? It's impossible to tell."))
    release
    end
}

script PathlessForest_EventScript_Bidoof {
