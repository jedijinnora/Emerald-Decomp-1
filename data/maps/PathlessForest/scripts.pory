mapscripts PathlessForest_MapScripts {
    MAP_SCRIPT_ON_LOAD : PathlessForest_OnLoad
    MAP_SCRIPT_ON_TRANSITION : PathlessForest_OnTransition
}

// 2, 3, 8, and 9 too close to 131 entrance
// 22 and 23 too close to secret entrance

script PathlessForest_OnLoad {
    call(PathlessForest_EventScript_Close_4)
    call(PathlessForest_EventScript_Close_7)
    call(PathlessForest_EventScript_Close_10)
    call(PathlessForest_EventScript_Close_13)
    call(PathlessForest_EventScript_Close_16)
    call(PathlessForest_EventScript_Close_17)
    call(PathlessForest_EventScript_Close_18)
    call(PathlessForest_EventScript_Close_19)
    call(PathlessForest_EventScript_Close_20)
    call(PathlessForest_EventScript_Close_21)
    call(PathlessForest_EventScript_Close_24)
    end
}

script PathlessForest_OnTransition {
    call_if_ne(VAR_KELDEO_QUEST_STATE, 20, PathlessForest_EventScript_HideKeldeo)
    end
}

const LOCALID_KELDEO = 5

script PathlessForest_EventScript_HideKeldeo {
    setflag(FLAG_TEMP_D)
    setvar(VAR_TEMP_0, 1)
    return
}

script PathlessForest_EventScript_KeldeoTrigger {
    lock
    playse(SE_PIN)
    setflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
    applymovement(LOCALID_KELDEO, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_KELDEO, PathlessForest_Movement_KeldeoApproach)
    waitmovement(0)
    goto(PathlessForest_EventScript_Keldeo)
    end
}

script PathlessForest_EventScript_Keldeo {
    lock
    faceplayer
    playmoncry(SPECIES_KELDEO, CRY_MODE_ENCOUNTER)
    msgbox(format("Keldeo is wondering what took you so long?"))
    waitmessage
    closemessage
    setflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
    applymovement(LOCALID_KELDEO, Common_Movement_WalkInPlaceRight)
    waitmovement(0)
    msgbox(format("…"))
    applymovement(LOCALID_KELDEO, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    applymovement(LOCALID_KELDEO, Common_Movement_WalkInPlaceUp)
    waitmovement(0)
    msgbox(format("Nevermind! Onwards, friend!"))
    waitmessage
    closemessage
    applymovement(LOCALID_KELDEO, PathlessForest_Movement_KeldeoExit)
    waitmovement(0)
    applymovement(LOCALID_KELDEO, Common_Movement_WalkInPlaceUp)
    waitmovement(0)
    playse(SE_EXIT)
    waitse
    removeobject(LOCALID_KELDEO)
    setvar(VAR_KELDEO_QUEST_STATE, 30)
    setvar(VAR_TEMP_0, 1)
    release
    end
}

movement PathlessForest_Movement_KeldeoApproach {
    walk_left
    walk_up
}

movement PathlessForest_Movement_KeldeoExit {
    walk_right * 4
    walk_up * 2
}

// 0x001 grass
// 0x00E top of tree
// 0x016 bottom of tree
// 0x0C6 overlapping trees

script PathlessForest_EventScript_Toggle_0 {
    clearflag(FLAG_TEMP_F)
    call_if_set(FLAG_TEMP_1, PathlessForest_EventScript_Open_0)
    goto_if_set(FLAG_TEMP_F, Common_EventScript_NopReturn)
    call(PathlessForest_EventScript_Close_0)
    return
}

