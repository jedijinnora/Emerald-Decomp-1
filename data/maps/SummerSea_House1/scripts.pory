mapscripts SummerSea_House1_MapScripts {
    MAP_SCRIPT_ON_TRANSITION : SummerSea_House1_OnTransition
    MAP_SCRIPT_ON_RESUME : SummerSea_House1_OnResume
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_MANAPHY_QUEST_STATE, 15: SummerSea_House1_EventScript_Return1
        VAR_MANAPHY_QUEST_STATE, 25: SummerSea_House1_EventScript_Return2
        VAR_MANAPHY_QUEST_STATE, 35: SummerSea_House1_EventScript_Return3
        VAR_MANAPHY_QUEST_STATE, 45: SummerSea_House1_EventScript_Return4
        VAR_MANAPHY_QUEST_STATE, 55: SummerSea_House1_EventScript_Return5
        VAR_MANAPHY_QUEST_STATE, 65: SummerSea_House1_EventScript_Return6
        VAR_MANAPHY_QUEST_STATE, 75: SummerSea_House1_EventScript_Return7
    ] 
}

const LOCALID_WOMAN = 1
const LOCALID_MANAPHY = 2
const LOCALID_PHIONE_1 = 3
const LOCALID_PHIONE_2 = 4
const LOCALID_PHIONE_3 = 5
const LOCALID_PHIONE_4 = 6
const LOCALID_PHIONE_5 = 7
const LOCALID_PHIONE_6 = 8
const LOCALID_PHIONE_7 = 9

// Manaphy Quest State (VAR_MANAPHY_QUEST_STATE)
// 0 - new game
//
// 10 - visited, spoke to woman and manaphy, got first clue
// 11 - found phione 1: Route 133, Sunny Lagoon (a sunny circle in the sea)
// 15 - completed phione 1 task: shown Rain Dance TM
//
// 20 - returned, got next clue
// 21 - found phione 2: Dewford Resort (a place full of entitled humans)
// 25 - completed phione 2 task: given Snowball
//
// 30 - returned, got next clue
// 31 - found phione 3: Route 125, Shoal Cave (somewhere with strong tides)
// 35 - completed phione 3 task: given Shell Bell
//
// 40 - returned, got next clue
// 41 - found phione 4: Slateport Beach (a shop with fizzy drinks)
// 45 - completed phione 4 task: given Lava Cookie
//
// 50 - returned, got next clue
// 51 - found phione 5: Route 115, Meteor Falls (a meteor shower struck nearby)
// 55 - completed phione 5 task: shown Minior
//
// 60 - returned, got next clue
// 61 - found phione 6: Route 106, Granite Cave (lots of cool rocks)
// 65 - completed phione 6 task: given Water Stone
//
// 70 - returned, got next clue
// 71 - found phione 7: Route 129, Flower Paradise (shh! Manaphy's friend is sleeping here)
// 75 - completed phione 7 task: given Honey
//
// 80 - returned
// 85 - battled

script SummerSea_House1_OnResume {
	call_if_set(FLAG_SYS_CTRL_OBJ_DELETE, Common_EventScript_TryRemoveCaughtEncounter)
    end
}

script SummerSea_House1_OnTransition {
    call_if_set(FLAG_CAUGHT_MANAPHY, SummerSea_House1_EventScript_HideManaphy)
    call_if_set(FLAG_DEFEATED_MANAPHY, SummerSea_House1_EventScript_HideManaphy)
    call(SummerSea_House1_EventScript_HidePhione)
    end
}

script SummerSea_House1_EventScript_HideManaphy {
    setflag(FLAG_TEMP_12)
    return
}

script SummerSea_House1_EventScript_HidePhione {
    goto_if_ge(VAR_MANAPHY_QUEST_STATE, 75, Common_EventScript_NopReturn)
    setflag(FLAG_TEMP_7)
    goto_if_ge(VAR_MANAPHY_QUEST_STATE, 65, Common_EventScript_NopReturn)
    setflag(FLAG_TEMP_6)
    goto_if_ge(VAR_MANAPHY_QUEST_STATE, 55, Common_EventScript_NopReturn)
    setflag(FLAG_TEMP_5)
    goto_if_ge(VAR_MANAPHY_QUEST_STATE, 45, Common_EventScript_NopReturn)
    setflag(FLAG_TEMP_4)
    goto_if_ge(VAR_MANAPHY_QUEST_STATE, 35, Common_EventScript_NopReturn)
    setflag(FLAG_TEMP_3)
    goto_if_ge(VAR_MANAPHY_QUEST_STATE, 25, Common_EventScript_NopReturn)
    setflag(FLAG_TEMP_2)
    goto_if_ge(VAR_MANAPHY_QUEST_STATE, 15, Common_EventScript_NopReturn)
    setflag(FLAG_TEMP_1)
    return
}

script SummerSea_House1_EventScript_Woman {
    lock
    faceplayer
    goto_if_set(FLAG_CAUGHT_MANAPHY, SummerSea_House1_EventScript_WomanFinal)
    goto_if_set(FLAG_DEFEATED_MANAPHY, SummerSea_House1_EventScript_WomanReturn)
    goto_if_lt(VAR_MANAPHY_QUEST_STATE, 10, SummerSea_House1_EventScript_WomanIntro)
    goto_if_ge(VAR_MANAPHY_QUEST_STATE, 80, SummerSea_House1_EventScript_WomanOffer)
    msgbox(format("Poor little Manaphy…"))
    release
    end
}

script SummerSea_House1_EventScript_WomanIntro {
    msgbox(format("Do you know about the Pokémon Manaphy?"))
    msgbox(format("It's sometimes called the King of the Ocean."))
    msgbox(format("Manaphy travels the world's oceans with their attending Phione."))
    msgbox(format("But all the Phione got lost while traveling through Hoenn and Manaphy is sick."))
    msgbox(format("I've been tending to Manaphy, but I need a Trainer like you to find all the Phione and tell them where Manaphy is."))
    msgbox(format("Manaphy can give you clues about where they might be."))
    setvar(VAR_MANAPHY_QUEST_STATE, 9)
    release
    end
}

script SummerSea_House1_EventScript_WomanOffer {
    msgbox(format("Manaphy has an offer for you!"))
    release
    end
}

script SummerSea_House1_EventScript_WomanFinal {
    msgbox(format("I hope you're treating Manaphy well!"))
    release
    end
}

script SummerSea_House1_EventScript_WomanReturn {
    msgbox(format("Manaphy will come back eventually."))
    release
    end
}

script SummerSea_House1_EventScript_Return1 {
    lock
    applymovement(LOCALID_PHIONE_1, SummerSea_House1_Movement_Phione1ToPlayer)
    waitmovement(0)
    playmoncry(SPECIES_PHIONE, CRY_MODE_ENCOUNTER)
    applymovement(LOCALID_WOMAN, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    msgbox(format("Oh! You did it! You found the Phione at the Sunny Lagoon!"))
    msgbox(format("Manaphy is feeling a little better with one of their friends around."))
    waitmessage
    closemessage
    applymovement(LOCALID_PHIONE_1, SummerSea_House1_Movement_Phione1Return)
    waitmovement(0)
    msgbox(format("You should talk to them to get the next clue."))
    waitmessage
    closemessage
    applymovement(LOCALID_WOMAN, Common_Movement_WalkInPlaceRight)
    waitmovement(0)
    setvar(VAR_MANAPHY_QUEST_STATE, 19)
    release
    end
}

