movement SummerSea_House1_Movement_Phione1ToPlayer {
    walk_fast_down * 3
    walk_fast_right * 3
    jump_in_place_down
    emote_heart
}

movement SummerSea_House1_Movement_Phione1Return {
    walk_in_place_left
    walk_in_place_up
    walk_in_place_right
    walk_in_place_down
    walk_fast_left * 3
    walk_fast_up * 3
    face_right
}

movement SummerSea_House1_Movement_Phione2ToPlayer {
    walk_fast_right * 4
    walk_fast_down
    jump_in_place_down
    jump_in_place_down
    jump_in_place_down
}

movement SummerSea_House1_Movement_Phione2Return {
    emote_heart
    delay_16
    walk_fast_up
    walk_fast_left * 4
    face_right
}

movement SummerSea_House1_Movement_Phione3ToPlayer {
    walk_fast_left
    jump_2_left
    jump_2_down
    jump_2_left
    jump_in_place_down
}

movement SummerSea_House1_Movement_Phione3Return {
    walk_fast_right
    jump_2_right
    jump_2_right
    jump_2_up
    jump_in_place_left
}

movement SummerSea_House1_Movement_Phione4ToPlayer {
    walk_fast_right
    walk_fast_up
    walk_fast_right
    jump_in_place_down
    jump_in_place_down
    jump_in_place_down
    jump_in_place_down
}

movement SummerSea_House1_Movement_Phione4Return {
    jump_in_place_left
    jump_in_place_left
    walk_fast_left
    walk_fast_down
    walk_fast_left
    jump_in_place_right
}

movement SummerSea_House1_Movement_Phione5ToPlayer {
    walk_fast_up
    walk_fast_left * 4
    walk_in_place_down
}

movement SummerSea_House1_Movement_Phione5Return {
    walk_fast_right * 4
    walk_fast_down
    emote_heart
}

movement SummerSea_House1_Movement_Phione6ToPlayer {
    jump_left
    jump_down
    walk_in_place_down
    walk_in_place_down
}

movement SummerSea_House1_Movement_Phione6Return {
    jump_up
    jump_right
    emote_heart
    walk_in_place_left
    walk_in_place_up
    walk_in_place_right
    walk_in_place_down
}

movement SummerSea_House1_Movement_Phione7ToPlayer {
    jump_2_down
    jump_2_down
    jump_left
    emote_heart
}

movement SummerSea_House1_Movement_Phione7Return {
    jump_right
    jump_2_up
    jump_2_up
    walk_in_place_down
}

script SummerSea_House1_EventScript_Manaphy {
    lock
    applymovement(LOCALID_MANAPHY, Common_Movement_FacePlayer)
    playmoncry(SPECIES_MANAPHY, CRY_MODE_ENCOUNTER)
    waitmovement(0)
    msgbox(format("Manaphy: Pii qhihi!"))
    call_if_eq(VAR_MANAPHY_QUEST_STATE, 85, SummerSea_House1_EventScript_ManaphyBattle)
    call_if_eq(VAR_MANAPHY_QUEST_STATE, 80, SummerSea_House1_EventScript_ManaphyBattle)
    call_if_lt(VAR_MANAPHY_QUEST_STATE, 80, SummerSea_House1_EventScript_Hints)
    release
    end
}

script SummerSea_House1_EventScript_ManaphyBattle {
    setvar(VAR_MANAPHY_QUEST_STATE, 85)
    msgbox(format("Manaphy will join you if you prove yourself!"))
    msgbox(format("Ready for battle?"), MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, NO, Common_EventScript_NopReturn)
    setflag(FLAG_SMART_WILD_AI)
    call(Common_EventScript_CountBadges)
    switch(var(VAR_NUM_BADGES)) {
        case 2:
            createmon(1, 0, SPECIES_MANAPHY, 30, ITEM_MYSTIC_WATER, move1=MOVE_RAIN_DANCE, move2=MOVE_REST, move3=MOVE_TAKE_HEART, move4=MOVE_SCALD)
        case 3:
            createmon(1, 0, SPECIES_MANAPHY, 40, ITEM_MYSTIC_WATER, move1=MOVE_RAIN_DANCE, move2=MOVE_REST, move3=MOVE_TAKE_HEART, move4=MOVE_SCALD)
        case 4:
            createmon(1, 0, SPECIES_MANAPHY, 45, ITEM_MYSTIC_WATER, move1=MOVE_RAIN_DANCE, move2=MOVE_REST, move3=MOVE_TAKE_HEART, move4=MOVE_SCALD)
        case 5:
            createmon(1, 0, SPECIES_MANAPHY, 55, ITEM_MYSTIC_WATER, move1=MOVE_RAIN_DANCE, move2=MOVE_REST, move3=MOVE_TAKE_HEART, move4=MOVE_SCALD)
        case 6:
            createmon(1, 0, SPECIES_MANAPHY, 65, ITEM_MYSTIC_WATER, move1=MOVE_RAIN_DANCE, move2=MOVE_REST, move3=MOVE_TAKE_HEART, move4=MOVE_SCALD)
        case 7:
            createmon(1, 0, SPECIES_MANAPHY, 75, ITEM_MYSTIC_WATER, move1=MOVE_RAIN_DANCE, move2=MOVE_REST, move3=MOVE_TAKE_HEART, move4=MOVE_SCALD)
        case 8:
            createmon(1, 0, SPECIES_MANAPHY, 85, ITEM_MYSTIC_WATER, move1=MOVE_RAIN_DANCE, move2=MOVE_REST, move3=MOVE_TAKE_HEART, move4=MOVE_SCALD)
        default:
            createmon(1, 0, SPECIES_MANAPHY, 25, ITEM_MYSTIC_WATER, move1=MOVE_RAIN_DANCE, move2=MOVE_REST, move3=MOVE_TAKE_HEART, move4=MOVE_SCALD)
    }
	setflag(FLAG_SYS_CTRL_OBJ_DELETE)
	special(BattleSetup_StartLegendaryBattle)
	waitstate
    clearflag(FLAG_SMART_WILD_AI)
	clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
	specialvar(VAR_RESULT, GetBattleOutcome)
	goto_if_eq(VAR_RESULT, B_OUTCOME_WON, SummerSea_House1_EventScript_DefeatedManaphy)
	goto_if_eq(VAR_RESULT, B_OUTCOME_RAN, SummerSea_House1_EventScript_RanFromManaphy)
	goto_if_eq(VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, SummerSea_House1_EventScript_RanFromManaphy)
	setflag(FLAG_CAUGHT_MANAPHY)
    release
    end
}

script SummerSea_House1_EventScript_DefeatedManaphy {
	setflag(FLAG_DEFEATED_MANAPHY)
	goto(Common_EventScript_RemoveStaticPokemon)
	end
}

script SummerSea_House1_EventScript_RanFromManaphy {
	setflag(FLAG_DEFEATED_MANAPHY)
	setvar(VAR_0x8004, SPECIES_MANAPHY)
	goto(Common_EventScript_LegendaryFlewAway)
	end
}

script SummerSea_House1_EventScript_Hints {
    msgbox(format("Manaphy has been trying to remember where all the Phione went…"))
    switch(var(VAR_MANAPHY_QUEST_STATE)) {
        case 9:
        case 10:
        case 11:
            msgbox(format("The first Phione stayed behind on a sunny beach! Maybe they got sunstroke?"))
        case 19:
        case 20:
        case 21:
            msgbox(format("The second Phione was somewhere with a lot of entitled humans."))
        case 29:
        case 30:
        case 31:
            msgbox(format("The third Phione got swept away by strong tides!"))
        case 39:
        case 40:
        case 41:
            msgbox(format("The fourth Phione had way too many fizzy drinks."))
        case 49:
        case 50:
        case 51:
            msgbox(format("The fifth Phione saw a meteor! They went looking for the crater."))
        case 59:
        case 60:
        case 61:
            msgbox(format("The sixth Phione went spelunking for cool rocks."))
        case 69: // nice
        case 70:
        case 71:
            msgbox(format("Shh! The seventh Phione stayed behind to meet Manaphy's sleeping friend."))
    }
    switch(var(VAR_MANAPHY_QUEST_STATE)) {
        case 9:
        case 19:
        case 29:
        case 39:
        case 49:
        case 59:
        case 69:
            addvar(VAR_MANAPHY_QUEST_STATE, 1)
        default:
    }
    return
}

// rescued from r133, Sunny Lagoon
// have Rain Dance TM
script SummerSea_House1_EventScript_Phione1 {
    lockall
    applymovement(LOCALID_PHIONE_1, Common_Movement_FacePlayer)
    playmoncry(SPECIES_PHIONE, CRY_MODE_ENCOUNTER)
