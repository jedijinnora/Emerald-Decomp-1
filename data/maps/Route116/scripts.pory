mapscripts Route116_MapScripts {
	MAP_SCRIPT_ON_TRANSITION : Route116_OnTransition
	MAP_SCRIPT_ON_RESUME : Route116_OnResume
}

script Route116_OnTransition {
	call(Common_EventScript_SetWild_0)
	call(Common_EventScript_DisableBPReward)
	call_if_set(FLAG_DEFEATED_VIRIZION, Route116_EventScript_HideVirizion)
    call_if_set(FLAG_CAUGHT_VIRIZION, Route116_EventScript_HideVirizion)
	call_if_lt(VAR_KELDEO_QUEST_STATE, 40, Route116_EventScript_HideVirizion)
	end
}

script Route116_OnResume {
	call_if_set(FLAG_SYS_CTRL_OBJ_DELETE, Common_EventScript_TryRemoveCaughtEncounter)
    end
}

const LOCALID_VIRIZION = 31


script Route116_EventScript_HideVirizion {
    setflag(FLAG_TEMP_18)
    return
}

script Route116_EventScript_Virizion {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_VIRIZION, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
    setflag(FLAG_SMART_WILD_AI)
    call(Common_EventScript_CountBadges)
    switch(var(VAR_NUM_BADGES)) {
        case 2:
            createmon(1, 0, SPECIES_VIRIZION, 30, ITEM_LEPPA_BERRY, move1=MOVE_SACRED_SWORD, move2=MOVE_WORK_UP, move3=MOVE_GIGA_DRAIN, move4=MOVE_TAKE_DOWN)
        case 3:
            createmon(1, 0, SPECIES_VIRIZION, 40, ITEM_LEPPA_BERRY, move1=MOVE_SACRED_SWORD, move2=MOVE_WORK_UP, move3=MOVE_GIGA_DRAIN, move4=MOVE_TAKE_DOWN)
        case 4:
            createmon(1, 0, SPECIES_VIRIZION, 45, ITEM_LEPPA_BERRY, move1=MOVE_SACRED_SWORD, move2=MOVE_WORK_UP, move3=MOVE_GIGA_DRAIN, move4=MOVE_TAKE_DOWN)
        case 5:
            createmon(1, 0, SPECIES_VIRIZION, 55, ITEM_LEPPA_BERRY, move1=MOVE_SACRED_SWORD, move2=MOVE_WORK_UP, move3=MOVE_GIGA_DRAIN, move4=MOVE_TAKE_DOWN)
        case 6:
            createmon(1, 0, SPECIES_VIRIZION, 65, ITEM_LEPPA_BERRY, move1=MOVE_SACRED_SWORD, move2=MOVE_WORK_UP, move3=MOVE_GIGA_DRAIN, move4=MOVE_TAKE_DOWN)
        case 7:
            createmon(1, 0, SPECIES_VIRIZION, 75, ITEM_LEPPA_BERRY, move1=MOVE_SACRED_SWORD, move2=MOVE_WORK_UP, move3=MOVE_GIGA_DRAIN, move4=MOVE_TAKE_DOWN)
        case 8:
            createmon(1, 0, SPECIES_VIRIZION, 85, ITEM_LEPPA_BERRY, move1=MOVE_SACRED_SWORD, move2=MOVE_WORK_UP, move3=MOVE_GIGA_DRAIN, move4=MOVE_TAKE_DOWN)
        default:
            createmon(1, 0, SPECIES_VIRIZION, 25, ITEM_LEPPA_BERRY, move1=MOVE_SACRED_SWORD, move2=MOVE_WORK_UP, move3=MOVE_GIGA_DRAIN, move4=MOVE_TAKE_DOWN)
    }
	setflag(FLAG_SYS_CTRL_OBJ_DELETE)
	special(BattleSetup_StartLegendaryBattle)
	waitstate
    clearflag(FLAG_SMART_WILD_AI)
	clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
	specialvar(VAR_RESULT, GetBattleOutcome)
	goto_if_eq(VAR_RESULT, B_OUTCOME_WON, Route116_EventScript_DefeatedVirizion)
	goto_if_eq(VAR_RESULT, B_OUTCOME_RAN, Route116_EventScript_RanFromVirizion)
	goto_if_eq(VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, Route116_EventScript_RanFromVirizion)
	setflag(FLAG_CAUGHT_VIRIZION)
    release
    end
}

script Route116_EventScript_DefeatedVirizion {
	setflag(FLAG_DEFEATED_VIRIZION)
	goto(Common_EventScript_RemoveStaticPokemon)
	end
}

script Route116_EventScript_RanFromVirizion {
	setflag(FLAG_DEFEATED_VIRIZION)
	setvar(VAR_0x8004, SPECIES_VIRIZION)
	goto(Common_EventScript_LegendaryFlewAway)
	end
}

script Route116_EventScript_SableyeWoman {
    lock
    faceplayer
    if (flag(FLAG_RECEIVED_SABLEYE)) {
        msgbox(format("Once I calm down a little I'll fly home."))
        release
        end
    }
    msgbox(format("I had a terrifying encounter with some kind of gremlin!"))
    msgbox(format("First I couldn't get the image of this place out of my head, then a strange shadow kept following me."))
    msgbox(format("Now I've hiked out here and the music turns ominous every time I walk towards the stairs. I'm stuck!"))
	msgbox(format("Sableye is insisting on staying in my shadow. I'm no Trainer! How can I get rid of it?"))
	playmoncry(SPECIES_SABLEYE, CRY_MODE_NORMAL)
	delay(10)
	playmoncry(SPECIES_SABLEYE, CRY_MODE_NORMAL)
	msgbox(format("I've just about had it! Please, take this Pokémon away!"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
	    setflag(FLAG_RECEIVED_SABLEYE)
	    givemon(SPECIES_SABLEYE, 10)
	    playfanfare(MUS_OBTAIN_ITEM)
	    bufferspeciesname(STR_VAR_1, SPECIES_SABLEYE)
        msgbox("{PLAYER} received {STR_VAR_1}!")
	    waitmessage
	    waitfanfare
	    goto_if_eq(VAR_RESULT, MON_GIVEN_TO_PARTY, SableyeToParty)
	    goto_if_eq(VAR_RESULT, MON_GIVEN_TO_PC, SableyeToPC)

        SableyeToParty:
        msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            call(Common_EventScript_GetGiftMonPartySlot)
            call(Common_EventScript_NameReceivedPartyMon)
        }
        goto(SableyeEnd)

        SableyeToPC:
        msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            call(Common_EventScript_NameReceivedBoxMon)
        }
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_SABLEYE)
        call(Common_EventScript_TransferredToPC)
        SableyeEnd:
        msgbox(format("If Sableye offers you a cookbook, don't accept!"))
        release
        end
    }
    msgbox(format("Oh no…"))
	msgbox(format("Someone get me out of this Twilight Zone, I'm begging you!"))
    release
    end
}

script Route116_EventScript_RouteSignRustboro {
	msgbox("Route 116\n{LEFT_ARROW} Rustboro City", MSGBOX_SIGN)
	end
}

script Route116_EventScript_RusturfTunnelSign {
	msgbox(format("Rusturf Tunnel\p “Progress is under way to link Rustboro and Verdanturf!”"), MSGBOX_SIGN)
	end
}

script Route116_EventScript_TunnelersRestHouseSign {
	msgbox("Tunneler's Rest House", MSGBOX_SIGN)
	end
}

script Route116_EventScript_Nurse {
	lock
	faceplayer
	msgbox(format("Want me to heal your Pokémon?"), MSGBOX_YESNO)
	call_if_eq(VAR_RESULT, YES, Common_EventScript_OutOfCenterPartyHeal)
	msgbox(format("Be careful, Trainer!"))
	release
	end
}

script Route116_EventScript_Joey {
	trainerbattle_single(TRAINER_JOEY, Route116_Text_JoeyIntro, Route116_Text_JoeyDefeat)
	msgbox(Route116_Text_JoeyPostBattle, MSGBOX_AUTOCLOSE)
	call(Route116_EventScript_TryJoeyRematch)
	release
	end
}
script Route116_EventScript_TryJoeyRematch {
	lock
    call(Common_EventScript_ShouldDoRematch)
	goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_NopReturn)
	setvar(VAR_0x8003, TRAINER_JOEY)
	setvar(VAR_0x8004, 1)
	if (defeated(TRAINER_KAREN)) {
		msgbox(format("Include Karen and make it a double battle?"), MSGBOX_YESNO)
		if (var(VAR_RESULT) == YES) {
			addvar(VAR_0x8004, 1)
			call(Common_EventScript_CheckRecentRematchesSetBP)
			trainerbattle_two_trainers(TRAINER_JOEY, Route116_Text_JoeyDefeat, TRAINER_KAREN, Route116_Text_KarenRematchDefeat)
			special(UpdateRecentTrainers)
			return
		}
	}
	call(Common_EventScript_CheckRecentRematchesSetBP)
	trainerbattle_no_intro(TRAINER_JOEY, Route116_Text_JoeyDefeat)
	special(UpdateRecentTrainers)
	return
}

