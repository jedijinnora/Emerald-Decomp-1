mapscripts SootopolisGardens_MapScripts {
    MAP_SCRIPT_ON_TRANSITION : SootopolisGardens_OnTransition
}

script SootopolisGardens_OnTransition {
    setflag(FLAG_LANDMARK_SOOTOPOLIS_GARDENS)
    end
}

script SootopolisGardens_EventScript_Sign {
    msgbox(format("Sootopolis Gardens"), MSGBOX_SIGN)
    end
}

script SootopolisGardens_EventScript_Woman {
    msgbox(format("Many of the Pokémon here have a type advantage against the Sootopolis Gym."), MSGBOX_NPC)
    end
}

script SootopolisGardens_EventScript_OldWoman {
    msgbox(format("It was a lot of work getting Berries to grow on this terrace.\nI hope you appreciate it!"), MSGBOX_NPC)
    end
}