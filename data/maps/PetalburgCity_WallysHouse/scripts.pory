mapscripts PetalburgCity_WallysHouse_MapScripts {}

script PetalburgCity_WallysHouse_EventScript_WallysDad {
	lock
	faceplayer
	msgbox(format("My wife's pregnancy is going well! I'm making sure to get her everything she asks for!"))
	release
	end
}

script PetalburgCity_WallysHouse_EventScript_WallysMom {
	lock
	faceplayer
	goto_if_set(FLAG_PETALBURG_HAPPINY_TRADE_COMPLETED, HappinyTradeCompleted)
	setvar(VAR_0x8008, INGAME_TRADE_HAPPINY)
	copyvar(VAR_0x8004, VAR_0x8008)
	specialvar(VAR_RESULT, GetInGameTradeSpeciesInfo)
	copyvar(VAR_0x8009, VAR_RESULT)
	msgbox(format("When I found out I was pregnant, I got a Happiny in case I had a health scare."))
	msgbox(format("But everything's been going smoothly…"))
	msgbox(format("Maybe instead I should have gotten a Pokémon to help us around the house."))
	msgbox(format("Do you have a Gardevoir? I'll trade you my Happiny."), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, DeclineHappinyTrade)
	msgbox(format("Oh, thank goodness!"))
	waitmessage
	special(ChoosePartyMon)
	waitstate
	copyvar(VAR_0x800A, VAR_0x8004)
	goto_if_eq(VAR_0x8004, PARTY_NOTHING_CHOSEN, DeclineHappinyTrade)
	copyvar(VAR_0x8005, VAR_0x800A)
	specialvar(VAR_RESULT, GetTradeSpecies)
	copyvar(VAR_0x800B, VAR_RESULT)
	goto_if_ne(VAR_RESULT, VAR_0x8009, SelectedNotGardevoir)
	copyvar(VAR_0x8004, VAR_0x8008)
	copyvar(VAR_0x8005, VAR_0x800A)
	special(CreateInGameTradePokemon)
	special(DoInGameTradeScene)
	waitstate
	msgbox(format("I hope a trainer like you will raise Happiny big and strong!"))
	setflag(FLAG_PETALBURG_HAPPINY_TRADE_COMPLETED)
	release
	end

	DeclineHappinyTrade:
	msgbox(format("If you won't trade, I suppose I'll have to figure something else out."))
	release
	end

	SelectedNotGardevoir:
	bufferspeciesname(STR_VAR_1, VAR_0x800B)
	msgbox(format("{STR_VAR_1}? Mmm, I don't think so."))
	release
	end

	HappinyTradeCompleted:
	msgbox(format("I just want the best for my child, whoever they turn out to be."))
	release
	end
}