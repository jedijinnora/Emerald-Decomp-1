mapscripts RustboroCity_House4_MapScripts {}

script RustboroCity_House4_EventScript_PsychicF {
    lock
	faceplayer
	msgbox(format("Harness the power of your mind to achieve enlightenment!"))
	goto_if_unset(FLAG_RECEIVED_TWISTED_SPOON, RustboroCity_House4_EventScript_NoSmartPokemon)
	msgbox(format("The whole world may be an illusion, but the shadows on the cave wall can still prove useful."))
	msgbox(format("Do you feel real today?"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, YES, RustboroCity_House4_EventScript_RealToday)
	msgbox(format("The categories were made by man, but that doesn't make them meaningless."))
	release
	end
}

script RustboroCity_House4_EventScript_RealToday {
    msgbox(format("That's just what a P-zombie would say!"))
}

script RustboroCity_House4_EventScript_TryGiveTwistedSpoon {
	msgbox(format("Show me a Smart Pokémon and I'll pass on a secret!"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, RustboroCity_House4_EventScript_NoSmartPokemon)
	special(ChoosePartyMon)
	waitstate
	copyvar(VAR_RESULT, VAR_0x8004)
	goto_if_eq(VAR_RESULT, PARTY_NOTHING_CHOSEN, RustboroCity_House4_EventScript_NoSmartPokemon)
	setvar(VAR_0x8005, CONTEST_CATEGORY_SMART)
	specialvar(VAR_TEMP_1, GetPartyMonContestRibbon)
	goto_if_ge(VAR_TEMP_1, 1, RustboroCity_House4_EventScript_GiveTwistedSpoon)
	setvar(VAR_0x8005, CONTEST_CATEGORY_SMART)
	specialvar(VAR_TEMP_2, GetPartyMonContestStat)
	goto_if_ge(VAR_TEMP_2, 100, RustboroCity_House4_EventScript_GiveTwistedSpoon)
	goto(RustboroCity_House4_EventScript_NoSmartPokemon)
	end
}

script RustboroCity_House4_EventScript_GiveTwistedSpoon {
	msgbox(format("There is no spoon!"))
	giveitem(ITEM_TWISTED_SPOON)
	goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull)
	setflag(FLAG_RECEIVED_TWISTED_SPOON)
	release
	end
}

script RustboroCity_House4_EventScript_NoSmartPokemon {
	msgbox(format("Congrats - you're in the top 99%!"))
	release
	end
}

script RustboroCity_House4_EventScript_BlackBelt {
    lock
	faceplayer
	msgbox(format("Strength of the body is where it's at!"))
	goto_if_unset(FLAG_RECEIVED_BLACK_BELT, RustboroCity_House4_EventScript_TryGiveBlackBelt)
	msgbox(format("Consistent exercise is the key! Big gains start with small habits."))
	msgbox(format("Have you been taking care of yourself?"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, RustboroCity_House4_EventScript_NoToughPokemon)
	msgbox(format("Good job! This dude believes in you!"))
	release
	end
}

script RustboroCity_House4_EventScript_TryGiveBlackBelt {
	msgbox(format("Show me a Tough Pokémon and I'll reward your commitment!"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, RustboroCity_House4_EventScript_NoToughPokemon)
	special(ChoosePartyMon)
	waitstate
	copyvar(VAR_RESULT, VAR_0x8004)
	goto_if_eq(VAR_RESULT, PARTY_NOTHING_CHOSEN, RustboroCity_House4_EventScript_NoToughPokemon)
	setvar(VAR_0x8005, CONTEST_CATEGORY_TOUGH)
	specialvar(VAR_TEMP_1, GetPartyMonContestRibbon)
	goto_if_ge(VAR_TEMP_1, 1, RustboroCity_House4_EventScript_GiveBlackBelt)
	setvar(VAR_0x8005, CONTEST_CATEGORY_TOUGH)
	specialvar(VAR_TEMP_2, GetPartyMonContestStat)
	goto_if_ge(VAR_TEMP_2, 100, RustboroCity_House4_EventScript_GiveBlackBelt)
	goto(RustboroCity_House4_EventScript_NoToughPokemon)
	end
}

script RustboroCity_House4_EventScript_GiveBlackBelt {
	msgbox(format("That dedication to fitness deserves this belt!"))
	giveitem(ITEM_BLACK_BELT)
	goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull)
	setflag(FLAG_RECEIVED_BLACK_BELT)
	release
	end
}

script RustboroCity_House4_EventScript_NoToughPokemon {
	msgbox(format("Weak! Go chug some protein shakes."))
	release
	end
}

script RustboroCity_House4_EventScript_Gallade {
    lock
    applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
    waitmovement(0)
    playmoncry(SPECIES_GALLADE, CRY_MODE_ENCOUNTER)
    msgbox(format("Gallade: En garde!"))
    release
    end
}