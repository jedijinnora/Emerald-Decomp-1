mapscripts Oldale_Ruins_MapScripts {
    MAP_SCRIPT_ON_LOAD : OldaleRuins_OnLoad
}

script OldaleRuins_OnLoad {
    call_if_unset(FLAG_OLDALE_RUINS_OPEN_DOOR_1, OldaleRuins_EventScript_CloseRoom1)
    call_if_unset(FLAG_OLDALE_RUINS_OPEN_DOOR_2, OldaleRuins_EventScript_CloseRoom2)
    call_if_unset(FLAG_OLDALE_RUINS_OPEN_DOOR_3, OldaleRuins_EventScript_CloseRoom3)
    call_if_unset(FLAG_OLDALE_RUINS_OPEN_DOOR_4, OldaleRuins_EventScript_CloseRoom4)
    call_if_unset(FLAG_OLDALE_RUINS_OPEN_DOOR_5, OldaleRuins_EventScript_CloseRoom5)
    end
}

script OldaleRuins_EventScript_CloseRoom1 {
    setmetatile(24, 31, METATILE_General_RockWall_RockBase, TRUE)
	setmetatile(24, 32, METATILE_General_RockWall_SandBase, TRUE)
    return
}

script OldaleRuins_EventScript_CloseRoom2 {
    setmetatile(14, 24, METATILE_General_RockWall_RockBase, TRUE)
	setmetatile(14, 25, METATILE_General_RockWall_SandBase, TRUE)
    return
}

script OldaleRuins_EventScript_CloseRoom3 {
    setmetatile(18, 14, METATILE_General_RockWall_RockBase, TRUE)
	setmetatile(18, 15, METATILE_General_RockWall_SandBase, TRUE)
    return
}

script OldaleRuins_EventScript_CloseRoom4 {
    setmetatile(30, 14, METATILE_General_RockWall_RockBase, TRUE)
	setmetatile(30, 15, METATILE_General_RockWall_SandBase, TRUE)
    return
}

script OldaleRuins_EventScript_CloseRoom5 {
    setmetatile(34, 24, METATILE_General_RockWall_RockBase, TRUE)
	setmetatile(34, 25, METATILE_General_RockWall_SandBase, TRUE)
    return
}

script OldaleRuins_EventScript_AstronomyRock_Shiny {
    lock
    msgbox(format("The stone is covered in carvings that seem to record celestial observations."))
    msgbox(format("Looks like these have something to do with constellations."))
    release
    end
}

script OldaleRuins_EventScript_AstronomyRock_Moon {
    lock
    msgbox(format("The stone is covered in carvings that seem to record celestial observations."))
    msgbox(format("Looks like these have something to do with the Moon."))
    release
    end
}

