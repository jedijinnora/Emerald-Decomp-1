	"Ugh, my shoes are soggy."
}
script Route119_WeatherInstitute_1F_EventScript_RainBook {
	lock
	msgbox(format("This shelf has info on the Rainy weather condition."))
	msgbox(format("It's a lot to read. Continue?"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, Route119_WeatherInstitute_1F_EventScript_ShelfEnd)
	msgbox(format("Rain is set by the move Rain Dance or the ability Drizzle."))
	msgbox(format("It lasts for 5 turns, or 8 if the user holds a Damp Rock."))
	msgbox(format("Rain has the following effects:"))
	msgbox(format("Water-type moves are boosted by 50%. Fire-type moves are weakened by 50%."))
	msgbox(format("Castform changes to its Water-type Rainy form and has increased stats."))
	msgbox(format("Rain activates the abilities Dry Skin, Forecast, Hydration, Rain Dish, and Swift Swim."))
	msgbox(format("The move Electro Shot does not require a charging turn."))
	msgbox(format("Moonlight, Synthesis, and Morning Sun restore less HP."))
	msgbox(format("Solar Beam and Solar Blade are 50% weaker."))
	msgbox(format("Weather Ball becomes Water-type and increases in power."))
	msgbox(format("Thunder, Hurricane, Bleakwind Storm, Wildbolt Storm, and Sandsear Storm will always hit."))
	release
}

