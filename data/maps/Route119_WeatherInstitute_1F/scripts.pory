script Route119_WeatherInstitute_1F_EventScript_HailBook {
	lock
	msgbox(format("This shelf has info on the Hail weather condition."))
	msgbox(format("It's a lot to read. Continue?"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, Route119_WeatherInstitute_1F_EventScript_ShelfEnd)
	msgbox(format("Hail is set by the moves Hail and Chilly Reception or the ability Snow Warning."))
	msgbox(format("It lasts for 5 turns, or 8 if the user holds an Icy Rock."))
	msgbox(format("Hail has the following effects:"))
	msgbox(format("Pokémon take 1/16 damage at the end of each turn unless Ice-type or protected by their ability or item."))
	msgbox(format("Ice-type Pokémon have their Defense boosted by 50%."))
	msgbox(format("The Pokémon Castform changes to its Ice-type Snowy form and has increased stats."))
	msgbox(format("Ice Face will change Eiscue from its Noice form to its Ice Face form."))
	msgbox(format("Hail activates the abilities Forecast, Ice Body, Snow Cloak, and Slush Rush."))
	msgbox(format("The move Aurora Veil may be used."))
	msgbox(format("Moonlight, Synthesis, and Morning Sun restore less HP."))
	msgbox(format("Solar Beam and Solar Blade are 50% weaker. Blizzard will always hit."))
	msgbox(format("Weather Ball becomes Ice-type and increases in power."))
	release
}

