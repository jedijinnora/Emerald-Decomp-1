mapscripts Route119_WeatherInstitute_1F_MapScripts {}

script Route119_WeatherInstitute_1F_EventScript_Bed {
	lockall
	msgbox("There's a bed…\nLet's take a rest.$")
	call(Common_EventScript_OutOfCenterPartyHeal)
	releaseall
	end
}

script Route119_WeatherInstitute_1F_EventScript_WeatherBallTutor {
	lock
	faceplayer
	setflag(FLAG_TUTOR_WEATHER_BALL)
	msgbox(format("I can teach your Pokémon the move Weather Ball if you'd like?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == NO) {
		Route119_WeatherInstitute_1F_EventScript_WeatherBallDeclined:
		msgbox(format("Fair enough."))
		release
		end
	}
	setvar(VAR_0x8005, MOVE_WEATHER_BALL)
	call(MoveTutor_EventScript_OpenPartyMenu)
	goto_if_eq(VAR_RESULT, 0, Route119_WeatherInstitute_1F_EventScript_WeatherBallDeclined)
	msgbox(format("Weather Ball doubles in power and changes type depending on the weather."))
	release
	end
}

script Route119_WeatherInstitute_1F_EventScript_ExpertsEnd {
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}
script Route119_WeatherInstitute_1F_EventScript_ShelfEnd {
	release
	end
}

script Route119_WeatherInstitute_1F_EventScript_SunExpert {
	lock
	faceplayer
	msgbox(format("I'm an expert on using Harsh Sunlight in double battles."))
	call(Common_EventScript_CountBadges)
	goto_if_lt(VAR_NUM_BADGES, 2, Route119_WeatherInstitute_1F_EventScript_ExpertsEnd)
	msgbox(format("Want to practice against my Sun team?"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, Route119_WeatherInstitute_1F_EventScript_ExpertsEnd)
	trainerbattle_no_intro(TRAINER_WEATHER_TUTOR_SUN, Route119_WeatherInstitute_1F_Text_SunDefeated)
	release
	end
}
text Route119_WeatherInstitute_1F_Text_SunDefeated {
	"Ack! My solar powers!"
}
script Route119_WeatherInstitute_1F_EventScript_SunBook {
	lock
	msgbox(format("This shelf has info on the Harsh Sunlight weather condition."))
	msgbox(format("It's a lot to read. Continue?"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, Route119_WeatherInstitute_1F_EventScript_ShelfEnd)
	msgbox(format("Harsh Sunlight is set by the move Sunny Day or the ability Drought."))
	msgbox(format("It lasts for 5 turns, or 8 if the user holds a Heat Rock."))
	msgbox(format("Harsh Sunlight has the following effects:"))
	msgbox(format("Fire-type moves are boosted by 50%. Water-type moves are weakened by 50%."))
	msgbox(format("No Pokémon can be frozen."))
	msgbox(format("Castform changes to its Fire-type Sunny form and has increased stats."))
	msgbox(format("Cherrim changes to its Sunshine form and has increased stats."))
	msgbox(format("Sun activates the abilities Chlorophyll, Dry Skin, Flower Gift, Forecast, Leaf Guard, Solar Power, and Protosynthesis."))
	msgbox(format("The ability Harvest is guaranteed to restore a used Berry."))
	msgbox(format("Moonlight, Synthesis, and Morning Sun restore more HP."))
	msgbox(format("Solar Beam and Solar Blade do not require a charging turn."))
	msgbox(format("Growth sharply boosts both Atk and Sp. Atk."))
	msgbox(format("Weather Ball becomes Fire-type and increases in power."))
	msgbox(format("The accuracy of Thunder and Hurricane lowers to 50%."))
	release
}

