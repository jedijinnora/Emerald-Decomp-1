mapscripts RustboroCity_CuttersHouse_MapScripts {
	MAP_SCRIPT_ON_TRANSITION : RustboroCity_CuttersHouse_OnTransition
}

const LOCALID_CUTTER = 1
const LOCALID_KELDEO = 3

script RustboroCity_CuttersHouse_OnTransition {
	call_if_not_defeated(TRAINER_CRITICAL_TUTOR, RustboroCity_CuttersHouse_EventScript_HideKeldeo)
	call_if_ne(VAR_KELDEO_QUEST_STATE, 0, RustboroCity_CuttersHouse_EventScript_HideKeldeo)
	setobjectxy(LOCALID_CUTTER, 7, 5)
	setobjectxyperm(LOCALID_CUTTER, 7, 5)
	setobjectmovementtype(LOCALID_CUTTER, MOVEMENT_TYPE_FACE_RIGHT)
	call(RustboroCity_CuttersHouse_EventScript_TryMoveCutter)
	setflag(FLAG_TEMP_E)
	end
}

script RustboroCity_CuttersHouse_EventScript_HideKeldeo {
	setflag(FLAG_TEMP_11)
	return
}

script RustboroCity_CuttersHouse_EventScript_TryMoveCutter {
	goto_if_not_defeated(TRAINER_CRITICAL_TUTOR, Common_EventScript_NopReturn)
	goto_if_ne(VAR_KELDEO_QUEST_STATE, 0, Common_EventScript_NopReturn)
	setobjectxy(LOCALID_CUTTER, 3, 4)
	setobjectxyperm(LOCALID_CUTTER, 3, 4)
	setobjectmovementtype(LOCALID_CUTTER, MOVEMENT_TYPE_FACE_LEFT)
	return
}

script RustboroCity_CuttersHouse_EventScript_CutterKeldeo {
	lock
	playmoncry(SPECIES_KELDEO, CRY_MODE_ENCOUNTER)
	applymovement(LOCALID_KELDEO, Common_Movement_WalkInPlaceRight)
	waitmovement(0)
	applymovement(LOCALID_CUTTER, Common_Movement_WalkInPlaceLeft)
	msgbox(format("Cutter: I'd come with you, but I'm getting too old for this sort of thing."))
	playmoncry(SPECIES_KELDEO, CRY_MODE_WEAK)
	msgbox(format("Keldeo: …"))
	playse(SE_PIN)
	applymovement(LOCALID_CUTTER, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(LOCALID_CUTTER, Common_Movement_FacePlayer)
	waitmovement(0)
	msgbox(format("Cutter: {PLAYER} is a very capable Trainer, you know."))
	applymovement(LOCALID_KELDEO, Common_Movement_FacePlayer)
	waitmovement(0)
	msgbox(format("What do you say? Willing to go on an adventure?"), MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, RustboroCity_CuttersHouse_EventScript_CriticalMenu)
	closemessage
	playmoncry(SPECIES_KELDEO, CRY_MODE_ENCOUNTER)
	applymovement(LOCALID_KELDEO, RustboroCity_CuttersHouse_Movement_KeldeoHopRight)
	waitmovement(0)
	getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
	goto_if_le(VAR_TEMP_2, 4, KeldeoExit1)
	goto_if_eq(VAR_TEMP_1, 2, KeldeoExit2)
	KeldeoExit1:
	applymovement(LOCALID_KELDEO, RustboroCity_CuttersHouse_Movement_KeldeoExit1)
	goto(CutterFinish)
	KeldeoExit2:
	applymovement(LOCALID_KELDEO, RustboroCity_CuttersHouse_Movement_KeldeoExit2)
	CutterFinish:
	waitmovement(LOCALID_KELDEO)
	playse(SE_EXIT)
	removeobject(LOCALID_KELDEO)
	delay(10)
	call_if_eq(VAR_TEMP_1, 2, RustboroCity_CuttersHouse_EventScript_CutterToPlayer)
	msgbox(format("Cutter: Full of energy, that one. You'll have to hurry to catch up!"))
	msgbox(format("Oh, but you don't even know what's going on, do you?"))

	call(RustboroCity_CuttersHouse_EventScript_KeldeoInfo)
	setvar(VAR_KELDEO_QUEST_STATE, 10)
	release
	end
}

movement RustboroCity_CuttersHouse_Movement_KeldeoHopRight {
    jump_in_place_right
    jump_in_place_right
}

movement RustboroCity_CuttersHouse_Movement_KeldeoExit1 {
    walk_down * 2
	walk_right * 3
	walk_down * 2
}

movement RustboroCity_CuttersHouse_Movement_KeldeoExit2 {
	walk_left
    walk_down * 2
	walk_right * 4
	walk_down * 2
}


movement RustboroCity_CuttersHouse_Movement_CutterLeft {
	walk_left
}

script RustboroCity_CuttersHouse_EventScript_CutterToPlayer {
	applymovement(LOCALID_CUTTER, RustboroCity_CuttersHouse_Movement_CutterLeft)
	waitmovement(0)
	applymovement(LOCALID_CUTTER, Common_Movement_FacePlayer)
	waitmovement(0)
	return
}

script RustboroCity_CuttersHouse_EventScript_KeldeoInfo {
	msgbox(format("Cutter: Keldeo used to have a special move called Secret Sword."))
	msgbox(format("But sometime since leaving the Unova region, Keldeo's lost the ability to use it at full power."))
	msgbox(format("Somewhere near Pacifidlog Town is the Pathless Forest."))
	msgbox(format("On the other side is a secret grove where Keldeo can regain the power to use Secret Sword."))
	msgbox(format("I have full confidence in you, {PLAYER}!"))
	closemessage
	return
}

script RustboroCity_CuttersHouse_EventScript_Cutter {
	goto_if_unset(FLAG_TEMP_11, RustboroCity_CuttersHouse_EventScript_CutterKeldeo)
	lock
	faceplayer
	goto_if_eq(VAR_KELDEO_QUEST_STATE, 40, RustboroCity_CuttersHouse_EventScript_KeldeoQuestFinished)
	goto_if_defeated(TRAINER_CRITICAL_TUTOR, RustboroCity_CuttersHouse_EventScript_CriticalMenu)
	msgbox(format("That determined expression…"))
	msgbox(format("The limber way you move…"))
	msgbox(format("You're after my special techniques, aren't you?"), MSGBOX_YESNO)
	if(!var(VAR_RESULT)) {
		msgbox(format("No? Shame."))
		release
		end
	}
	setflag(FLAG_TUTOR_HIGH_CRIT_MOVES)
	msgbox(format("Naturally! But hold on, I can't hand out the secrets of critical hits to just anyone."))
	msgbox(format("You'll have to beat me in a Pokémon battle first!"), MSGBOX_YESNO)
	if(!var(VAR_RESULT)) {
		msgbox(format("A coward like you wasn't worth it anyways."))
		release
		end
	}
	call(RustboroCity_CuttersHouse_EventScript_CriticalBattle)
	msgbox(format("Your Pokémon have shown their worth! I shall gladly tutor you in the ways of critical hits."))
	goto(RustboroCity_CuttersHouse_EventScript_CriticalMenu)
	release
	end
}

text RustboroCity_CuttersHouse_Text_CutterDefeated {
	"Cut down! Such style!"
}

script RustboroCity_CuttersHouse_EventScript_TryKeldeoMenu {
	goto_if_eq(VAR_KELDEO_QUEST_STATE, 0, Common_EventScript_NopReturn)
	goto_if_ge(VAR_KELDEO_QUEST_STATE, 100, Common_EventScript_NopReturn)
	dynmultipush("Keldeo?", 3)
}

script RustboroCity_CuttersHouse_EventScript_KeldeoQuestFinished {
	msgbox(format("Cutter: Oh! You found the secret grove and unlocked Keldeo's Secret Sword?"))
	msgbox(format("Amazing! Well, sounds like you had quite the trip!"))
	msgbox(format("If you haven't already, be sure to look around the region for the other Swords of Justice."))
	setvar(VAR_KELDEO_QUEST_STATE, 100)
	closemessage
	return
}

script RustboroCity_CuttersHouse_EventScript_CriticalMenu {
	dynmultipush("Teach a move", 1)
	dynmultipush("Rematch", 2)
	call(RustboroCity_CuttersHouse_EventScript_TryKeldeoMenu)
	msgbox(format("What do you need today?"))
	dynmultistack(0,0,FALSE,6,TRUE,1,DYN_MULTICHOICE_CB_NONE)
	switch(var(VAR_RESULT)) {
		case 1:
			call(RustboroCity_CuttersHouse_EventScript_CriticalTutor)
		case 2:
			call(RustboroCity_CuttersHouse_EventScript_CriticalBattle)
		case 3:
			call(RustboroCity_CuttersHouse_EventScript_KeldeoInfo)
		default:
			release
			end
	}
	goto(RustboroCity_CuttersHouse_EventScript_CriticalMenu)
	end
}

script RustboroCity_CuttersHouse_EventScript_CriticalTutor {
	dynmultipush("Focus Energy", 11)
	dynmultipush("Slash", 12)
	dynmultipush("Cross Chop", 13)
	dynmultipush("Air Cutter", 14)
	dynmultipush("Drill Peck", 15)
	dynmultipush("Cross Poison", 16)
	dynmultipush("Drill Run", 17)
	dynmultipush("X-Scissor", 18)
	dynmultipush("Shadow Claw", 19)
	dynmultipush("Leaf Blade", 20)
	dynmultipush("Psycho Cut", 21)
	dynmultipush("Night Slash", 22)
	msgbox(format("Which move should I teach?"))
	dynmultistack(0,0,FALSE,6,FALSE,0,DYN_MULTICHOICE_CB_NONE)
	switch(var(VAR_RESULT)) {
		case 11:
			setvar(VAR_0x8005, MOVE_FOCUS_ENERGY)
		case 12:
			setvar(VAR_0x8005, MOVE_SLASH)
		case 13:
			setvar(VAR_0x8005, MOVE_CROSS_CHOP)
		case 14:
			setvar(VAR_0x8005, MOVE_AIR_CUTTER)
		case 15:
			setvar(VAR_0x8005, MOVE_DRILL_PECK)
		case 16:
			setvar(VAR_0x8005, MOVE_CROSS_POISON)
		case 17:
			setvar(VAR_0x8005, MOVE_DRILL_RUN)
		case 18:
			setvar(VAR_0x8005, MOVE_X_SCISSOR)
		case 19:
			setvar(VAR_0x8005, MOVE_SHADOW_CLAW)
		case 20:
			setvar(VAR_0x8005, MOVE_LEAF_BLADE)
		case 21:
			setvar(VAR_0x8005, MOVE_PSYCHO_CUT)
		case 22:
			setvar(VAR_0x8005, MOVE_NIGHT_SLASH)
		default:
			return
	}
	call(MoveTutor_EventScript_OpenPartyMenu)
	msgbox(format("Continue teaching moves?"), MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, YES, RustboroCity_CuttersHouse_EventScript_CriticalTutor)
    return
}

script RustboroCity_CuttersHouse_EventScript_CriticalBattle {
	trainerbattle_no_intro(TRAINER_CRITICAL_TUTOR, RustboroCity_CuttersHouse_Text_CutterDefeated)
	return
}

script RustboroCity_CuttersHouse_EventScript_Lass {
	goto_if_defeated(TRAINER_CRITICAL_TUTOR, RustboroCity_CuttersHouse_EventScript_TryGiveScopeLens)
	msgbox(format("The move Cut is Steel-type and has a higher chance for critical hits."), MSGBOX_NPC)
}

script RustboroCity_CuttersHouse_EventScript_TryGiveScopeLens {
	if(flag(FLAG_RECEIVED_SCOPE_LENS)) {
		return
	}
	msgbox(format("Wow, you beat my dad! Here, you should have this!"))
	giveitem(ITEM_SCOPE_LENS)
	goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull)
	setflag(FLAG_RECEIVED_SCOPE_LENS)
	release
	end
}