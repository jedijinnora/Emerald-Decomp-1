const LOCALID_NURSE = 1

mapscripts EmeraldCape_PokemonCenter_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION : EmeraldCape_PokemonCenter_1F_OnTransition
    MAP_SCRIPT_ON_RESUME : CableClub_OnResume
}

script EmeraldCape_PokemonCenter_1F_OnTransition {
    setrespawn(HEAL_LOCATION_EMERALD_CAPE)
    end
}

script EmeraldCape_PokemonCenter_1F_EventScript_Nurse {
    setvar(VAR_0x800B, LOCALID_NURSE)
	call(Common_EventScript_PkmnCenterNurse)
	waitmessage
	waitbuttonpress
	release
	end
}

script EmeraldCape_PokemonCenter_1F_EventScript_Woman {
    lock
    faceplayer
    msgbox(format("It's hard to prep for the Elite Four when you don't know which member of their team will come out first."))
    msgbox(format("If only I had the TM for Protect…"))
    msgbox(format("Someone said it's in Victory Road, but I've looked everywhere and just can't find it!"))
    release
    end
}