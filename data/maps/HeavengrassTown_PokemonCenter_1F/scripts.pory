const LOCALID_NURSE = 1

mapscripts HeavengrassTown_PokemonCenter_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION : HeavengrassTown_PokemonCenter_1F_OnTransition
    MAP_SCRIPT_ON_RESUME : CableClub_OnResume
}

script HeavengrassTown_PokemonCenter_1F_OnTransition {
    setrespawn(HEAL_LOCATION_HEAVENGRASS_TOWN)
    end
}

script HeavengrassTown_PokemonCenter_1F_EventScript_Nurse {
    setvar(VAR_0x800B, LOCALID_NURSE)
	call(Common_EventScript_PkmnCenterNurse)
	waitmessage
	waitbuttonpress
	release
	end
}

